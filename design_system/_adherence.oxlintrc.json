{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/article/**",
              "components/collections/**",
              "components/feedback/**",
              "components/foundation/**",
              "components/navigation/**",
              "components/player/**",
              "components/promo/**",
              "components/settings/**",
              "components/sheets/**",
              "ui_kits/android-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Roboto|Roboto Flex|Roboto Serif|Material Symbols Rounded))/i]",
        "message": "Font not provided by the design system. Available: Roboto, Roboto Flex, Roboto Serif, Material Symbols Rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='AiSpotlightBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|ctaLabel|onEnable|onDismiss|style|key|ref|className|style|children)$/]",
        "message": "<AiSpotlightBanner> doesn't accept that prop. Declared props: title, body, ctaLabel, onEnable, onDismiss, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:source|title|thumbnail|publishedAt|readingTime|bookmarked|read|coverageCount|onClick|onBookmark|onQueue|onPlay|style|key|ref|className|style|children)$/]",
        "message": "<ArticleCard> doesn't accept that prop. Declared props: source, title, thumbnail, publishedAt, readingTime, bookmarked, read, coverageCount, onClick, onBookmark, onQueue, onPlay, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|selected|icon|badgeCount|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CategoryPill> doesn't accept that prop. Declared props: text, selected, icon, badgeCount, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CollectionGridCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|count|thumbnail|isDefault|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CollectionGridCard> doesn't accept that prop. Declared props: title, count, thumbnail, isDefault, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CollectionListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|count|thumbnail|isDefault|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CollectionListRow> doesn't accept that prop. Declared props: title, count, thumbnail, isDefault, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmationSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|iconTint|title|message|primaryLabel|primaryColor|onPrimary|secondaryLabel|onSecondary|tertiaryLabel|onTertiary|style|key|ref|className|style|children)$/]",
        "message": "<ConfirmationSheet> doesn't accept that prop. Declared props: icon, iconTint, title, message, primaryLabel, primaryColor, onPrimary, secondaryLabel, onSecondary, tertiaryLabel, onTertiary, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:illustration|icon|title|description|actionLabel|onAction|children|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: illustration, icon, title, description, actionLabel, onAction, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|icon|label|key|ref|className|style|children)$/]",
        "message": "<NavTab> doesn't accept that prop. Declared props: id, icon, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|fill|weight|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, fill, weight, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|style|key|ref|className|style|children)$/]",
        "message": "<InfoNote> doesn't accept that prop. Declared props: children, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OfflineIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|style|key|ref|className|style|children)$/]",
        "message": "<OfflineIndicator> doesn't accept that prop. Declared props: message, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PublisherAvatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:sourceName|domain|logoUrl|size|ringed|style|key|ref|className|style|children)$/]",
        "message": "<PublisherAvatar> doesn't accept that prop. Declared props: sourceName, domain, logoUrl, size, ringed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:broadcast|playing|onOpenArticle|onTuneOff|style|key|ref|className|style|children)$/]",
        "message": "<RadioCard> doesn't accept that prop. Declared props: broadcast, playing, onOpenArticle, onTuneOff, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectorField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|icon|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SelectorField> doesn't accept that prop. Declared props: label, value, icon, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SettingsCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<SettingsCard> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SettingsRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|iconBg|title|subtitle|trailing|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SettingsRow> doesn't accept that prop. Declared props: icon, iconBg, title, subtitle, trailing, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SheetActionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|iconTint|iconBg|title|subtitle|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SheetActionRow> doesn't accept that prop. Declared props: icon, iconTint, iconBg, title, subtitle, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SkeletonLoader'] > JSXAttribute > JSXIdentifier[name!=/^(?:rows|variant|style|key|ref|className|style|children)$/]",
        "message": "<SkeletonLoader> doesn't accept that prop. Declared props: rows, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SkeletonLoader'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:list|text)$/]",
        "message": "<SkeletonLoader> variant must be one of 'list' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StreamFolioSwitch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<StreamFolioSwitch> doesn't accept that prop. Declared props: checked, disabled, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubPageTopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onBack|trailing|style|key|ref|className|style|children)$/]",
        "message": "<SubPageTopBar> doesn't accept that prop. Declared props: title, onBack, trailing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwipeHintBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|onDismiss|style|key|ref|className|style|children)$/]",
        "message": "<SwipeHintBanner> doesn't accept that prop. Declared props: message, onDismiss, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToastBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|icon|actionLabel|onAction|style|key|ref|className|style|children)$/]",
        "message": "<ToastBanner> doesn't accept that prop. Declared props: message, icon, actionLabel, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrendingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:source|title|category|thumbnail|publishedAt|readingTime|bookmarked|onClick|onBookmark|onQueue|onPlay|style|key|ref|className|style|children)$/]",
        "message": "<TrendingCard> doesn't accept that prop. Declared props: source, title, category, thumbnail, publishedAt, readingTime, bookmarked, onClick, onBookmark, onQueue, onPlay, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TtsMiniPlayer'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|source|thumbnail|playing|sleepTimer|hasNext|onToggle|onNext|onExpand|style|key|ref|className|style|children)$/]",
        "message": "<TtsMiniPlayer> doesn't accept that prop. Declared props: title, source, thumbnail, playing, sleepTimer, hasNext, onToggle, onNext, onExpand, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
